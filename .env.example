APP_ENV=development

POSTGRES_DB=rag_db
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=change_me
# Host-run local development URL. Docker Compose overrides this inside containers.
DATABASE_URL=postgresql+asyncpg://rag_user:change_me@127.0.0.1:5433/rag_db

# Host-run local development URL. Docker Compose overrides this inside containers.
REDIS_URL=redis://127.0.0.1:6379/0

EMBEDDING_API_URL=http://212.80.22.161:8003/v1/embeddings
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DOCUMENT_PREFIX="passage: "
EMBEDDING_QUERY_PREFIX="query: "

# Host-run local development URL. Docker Compose overrides this inside containers.
RETRIEVAL_SERVICE_URL=http://127.0.0.1:8002

LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

CHUNK_SIZE=800
CHUNK_OVERLAP=120
DEFAULT_TOP_K=5
MAX_TOP_K=20
